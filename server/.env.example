# ---- required ----
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/lnpak
# Long random string (32+ chars). Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Website URL(s), comma separated. Used for CORS and for links in emails (the first one).
# On Vercel: CLIENT_URL=https://lnpak.com,https://www.lnpak.com
CLIENT_URL=http://localhost:5173
PUBLIC_SITE_URL=https://lnpak.com

# Cookies: use "none" + COOKIE_SECURE=true if the API and website are on different domains.
COOKIE_SAMESITE=lax
COOKIE_SECURE=false

# Number of proxies in front of the API (1 = Vercel / Render / Nginx). Used for visitor IPs in rate limits.
TRUST_PROXY=1

# Website images. On Vercel connect a Blob store (Storage → Blob) and this token is added automatically.
# Without the token images are saved to UPLOAD_DIR on the server's disk (local development only).
BLOB_READ_WRITE_TOKEN=
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=4

# ---- optional: email (password reset, client invitations, new-lead alerts) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=LN PAK LLC <no-reply@lnpak.com>
ADMIN_NOTIFY_EMAIL=

# ---- first Super Admin ----
# Either open /admin/setup in the browser and enter this key (needed once), or run npm run create-admin.
SETUP_KEY=
# Values for npm run create-admin (optional):
SUPER_ADMIN_NAME=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
