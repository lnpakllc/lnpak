# ---- required ----
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/lnpak
# Long random string (32+ chars). Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Frontend URL(s), comma separated. Used for CORS and links in emails.
CLIENT_URL=http://localhost:5173
PUBLIC_SITE_URL=https://lnpak.com

# Cookies: use "none" + COOKIE_SECURE=true if the API and website are on different domains.
COOKIE_SAMESITE=lax
COOKIE_SECURE=false

# Uploads (public website images)
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# ---- optional: email (password reset, client invitations, new-lead alerts) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=LN PAK LLC <no-reply@lnpak.com>
ADMIN_NOTIFY_EMAIL=

# ---- optional: first super admin (npm run create-admin) ----
SUPER_ADMIN_NAME=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
