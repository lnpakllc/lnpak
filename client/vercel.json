{
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://YOUR-API-DOMAIN/api/:path*" },
    { "source": "/uploads/:path*", "destination": "https://YOUR-API-DOMAIN/uploads/:path*" },
    { "source": "/sitemap.xml", "destination": "https://YOUR-API-DOMAIN/api/sitemap.xml" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/(admin|client)(.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] }
  ]
}
